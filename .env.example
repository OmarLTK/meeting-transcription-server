# =============================================================================
# meeting-transcription-server — Speakr configuration
# Copy to .env, fill in secrets, and NEVER commit .env.
# After ANY change:  docker compose down && docker compose up -d
# (`docker compose restart` does not re-read env_file.)
# =============================================================================

# --- Admin (created on first run; change immediately after first login) ------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# --- Speech-to-text: Groq Whisper (OpenAI-compatible endpoint) ---------------
# No diarization: transcripts have no speaker labels. See docs/DECISIONS.md.
# Groq free-tier audio quotas are org-wide; check current limits in the console.
TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_API_KEY=gsk_REPLACE_ME
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Speakr splits large files before sending (Groq rejects oversized uploads).
CHUNK_LIMIT=20MB
CHUNK_OVERLAP_SECONDS=3

# --- Summaries / titles / chat: local Ollama on the host ---------------------
# Ollama must run natively (Metal); Docker on macOS has no GPU passthrough.
# Context length is set on the Ollama side (OLLAMA_CONTEXT_LENGTH=32768),
# see scripts/start-ollama.sh. Speakr cannot fix a truncated context.
TEXT_MODEL_BASE_URL=http://host.docker.internal:11434/v1
TEXT_MODEL_API_KEY=ollama
TEXT_MODEL_NAME=gpt-oss:20b
SUMMARY_MAX_TOKENS=8000
CHAT_MAX_TOKENS=5000

# --- In-app recording: stream to server in 5 s chunks ------------------------
# Enables multi-hour recordings and resume-after-crash; keeps each request tiny.
ENABLE_SERVER_RECORDING_CHUNKS=true
RECORDING_CHUNK_SECONDS=5
RECORDING_MAX_HOURS=8

# --- Retention: strip audio after 10 days, keep transcript + summary ---------
# Irreversible. Create a tag with "Protect from Auto-Deletion" BEFORE enabling.
# DELETION_MODE must be audio_only; full_recording also deletes transcripts.
ENABLE_AUTO_DELETION=true
GLOBAL_RETENTION_DAYS=10
DELETION_MODE=audio_only
# Video is ~1 GB/hour; keep off.
VIDEO_RETENTION=false
# Do NOT set PRESERVE_TEMP_AUDIO (debug flag that keeps untracked audio copies).

# --- Access & security -------------------------------------------------------
ALLOW_REGISTRATION=false
ENABLE_PUBLIC_SHARING=false
ENABLE_INTERNAL_SHARING=true
RATELIMIT_ENABLED=true
# Served over HTTPS via Tailscale Serve, so cookies can be HTTPS-only.
SESSION_COOKIE_SECURE=true
# One reverse proxy (tailscaled) in front of the app.
TRUSTED_PROXY_HOPS=1

# --- Storage / DB ------------------------------------------------------------
SQLALCHEMY_DATABASE_URI=sqlite:////data/instance/transcriptions.db
UPLOAD_FOLDER=/data/uploads
FILE_STORAGE_BACKEND=local
AUDIO_COMPRESS_UPLOADS=true
AUDIO_CODEC=mp3
AUDIO_BITRATE=128k

# --- Workers -----------------------------------------------------------------
JOB_QUEUE_WORKERS=2
SUMMARY_QUEUE_WORKERS=2
JOB_MAX_RETRIES=3

LOG_LEVEL=INFO
